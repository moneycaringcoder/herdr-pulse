# How one snapshot becomes one sparkline. Rendered to docs/img/mechanism.svg.
#
# Laid out downward on purpose: a left-to-right chain of six nodes renders at
# about 9:1, which is illegible at README width.
#
# No unicode marks in labels — d2's bundled font has no glyph for them and they
# render as tofu.

direction: down

classes: {
  node: {
    shape: rectangle
    style: {
      stroke: "#8b949e"
      font-color: "#57606a"
      fill: transparent
      stroke-width: 2
    }
  }
  store: {
    shape: cylinder
    style: {
      stroke: "#8b949e"
      font-color: "#57606a"
      fill: transparent
      stroke-width: 2
    }
  }
  out: {
    shape: rectangle
    style: {
      stroke: "#8cd98c"
      font-color: "#57606a"
      fill: transparent
      stroke-width: 2
    }
  }
}

herdr: "herdr server" {
  class: node
  tooltip: one session.snapshot per interval
}

sampler: "sampler daemon\nevery 5s, one round trip" {class: node}

fold: "fold into this minute's bucket\nany agent working? blocked?\ndid state_change_seq move?" {class: node}

store: "history.json\n240 buckets x 60s per workspace\nreplaced by atomic rename" {class: store}

badge: "sidebar badge\n8 columns = 64 minutes" {class: out}

pane: "activity pane\n32 columns, state, duration" {class: out}

herdr -> sampler: "workspaces, agents,\nagent_status, state_change_seq" {
  style.stroke: "#8b949e"
  style.font-color: "#57606a"
}
sampler -> fold {style.stroke: "#8b949e"}
fold -> store {style.stroke: "#8b949e"}
store -> badge: "workspace.report_metadata" {
  style.stroke: "#8b949e"
  style.font-color: "#57606a"
}
store -> pane: "pulse --once / --watch" {
  style.stroke: "#8b949e"
  style.font-color: "#57606a"
}

gap: "a bucket never observed stays empty\nand renders as a gap, never as quiet" {
  shape: rectangle
  style: {
    stroke: "#8b949e"
    font-color: "#57606a"
    fill: transparent
    stroke-dash: 4
    stroke-width: 2
  }
}

store -> gap {
  style.stroke: "#8b949e"
  style.stroke-dash: 4
}
